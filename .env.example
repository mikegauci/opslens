# Local development only. Never expose either connection string to the browser.
MIGRATION_DATABASE_URL=postgresql://opslens:opslens@127.0.0.1:54329/opslens
DATABASE_URL=postgresql://opslens_app:opslens_app_dev@127.0.0.1:54329/opslens
HOST=127.0.0.1
PORT=3000

# Optional server-side File Search tooling. Keep the actual values in ignored .env.
# OPENAI_API_KEY=
# OPENAI_VECTOR_STORE_ID=
# OPENAI_FILE_SEARCH_MODEL=

# Optional PLAN-10 live analytics copilot, for a private loopback development server.
# Enable only at 127.0.0.1 with OPENAI_API_KEY and a Responses model available to the API project.
# OPSLENS_COPILOT_LOCAL=1
# OPSLENS_COPILOT_MODEL=
